# OBS user the workflows authenticate as.
OBS_USER=balanza

# Distrobox container name where `osc` is installed and authenticated.
OSC_DISTROBOX=osc

# CD image used by container.RunOneShot for per-submodule deps bundling.
CD_IMAGE=ghcr.io/trento-project/continuous-delivery:latest

# Factory project the workflows derive personal subprojects from.
FACTORY_PROJECT=devel:sap:trento:factory

# Restate handler address. Restate-server connects here to invoke workflows.
HANDLER_ADDR=:9080

# Repository root (super-repo). Defaults to the parent of .workflows/.
TRENTO_REPO_ROOT=
